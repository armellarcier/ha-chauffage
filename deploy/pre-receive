#!/usr/bin/env bash
# Git "pre-receive" hook for a bare repository on the Home Assistant machine:
# a `git push` of the main branch deploys the project there (scripts/deploy.sh).
# If the deployment fails (invalid HA configuration…), the previous version is restored
# and the push is REJECTED.
#
# Installation: see CONTRIBUTING.md, "git push (for your own server)".
# Bare repository settings:
#   git config deploy.haconfig /path/to/ha/config
#   deploy.env (at the root of the bare repository, optional): PROD_HA_URL, PROD_HA_TOKEN
set -euo pipefail

cfg=$(git config deploy.haconfig || true)
[ -n "$cfg" ] || { echo "deploy.haconfig is not set: git config deploy.haconfig /path/to/ha/config" >&2; exit 1; }

zero=0000000000000000000000000000000000000000
while read -r _old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  [ "$new" = "$zero" ] && continue
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  git archive "$new" | tar -x -C "$tmp"
  echo "→ Deploying ${new:0:7} to $cfg"
  if ! ENV_FILE="$PWD/deploy.env" bash "$tmp/scripts/deploy.sh" "$cfg"; then
    echo "✋ Push rejected: deployment failed (production unchanged)." >&2
    exit 1
  fi
done

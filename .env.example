# Copy to .env (never committed). Tokens: HA profile → Security → Long-lived access tokens.

# Development HA (dev/compose.yaml)
DEV_HA_URL=http://localhost:8124
# Optional: by default the token written by the dev setup (dev/hass/.dev-token) is used
DEV_HA_TOKEN=

# Production HA — optional: used by `scripts/logs.sh prod`
PROD_HA_URL=
PROD_HA_TOKEN=

# Extra curl options. HA served over HTTPS and reached through localhost (certificate issued
# for another name): CURL_OPTS=-k  (skips certificate verification; keep it for local calls)
CURL_OPTS=

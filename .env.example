# Copier en .env (jamais commité). Jetons : profil HA → Sécurité → Jetons d'accès longue durée.

# HA de développement (dev/compose.yaml)
DEV_HA_URL=http://localhost:8124
DEV_HA_TOKEN=

# HA de production — facultatif : sert à scripts/deploy.sh pour vérifier la config et recharger
PROD_HA_URL=
PROD_HA_TOKEN=

# Options curl supplémentaires. HA en HTTPS joint via localhost (certificat émis pour un
# autre nom) : CURL_OPTS=-k  (ne vérifie pas le certificat ; à réserver aux appels locaux)
CURL_OPTS=

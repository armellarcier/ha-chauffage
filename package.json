{
  "name": "ha-chauffage",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The card: TypeScript sources in frontend/src, bundled by esbuild; and its tests",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc",
    "test": "node --test \"tests/js/**/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"frontend/**\" --test-coverage-lines=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"tests/js/**/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2"
  }
}
